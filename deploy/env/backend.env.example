# ============================================================
# 后端环境变量 - 开发环境模板
# 使用方法: 复制为 backend.env 并按需修改（start-dev 脚本会自动复制）
# 注意: 变量名与 backend/config/settings/*.py 中读取的名称保持一致
# ============================================================

# Django 配置
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=django-insecure-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL 数据库（容器内主机名为 postgres）
DB_NAME=team_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Redis / Celery（架构预留）
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS 跨域（开发环境 dev.py 已允许全部来源，此处供参考）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# 字段加密密钥（cryptography.fernet，留空则开发环境每次自动生成）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# 邮件配置（按需填写）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
