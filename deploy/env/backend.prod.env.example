# ============================================================
# 后端环境变量 - 生产环境模板
# 使用方法: 复制为 backend.prod.env 并务必修改所有敏感项！
# 注意: 变量名与 backend/config/settings/*.py 中读取的名称保持一致
# ============================================================

# Django 配置
DJANGO_SETTINGS_MODULE=config.settings.prod
# ⚠️ 必须替换为随机强密钥
# 生成: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-SECRET-KEY
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# PostgreSQL 数据库（须与 docker-compose.prod.yml 中 postgres 凭据保持一致）
DB_NAME=team_management
DB_USER=postgres
DB_PASSWORD=ChangeMeInProduction123
DB_HOST=postgres
DB_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
NOTIFICATION_STREAM_REDIS_URL=redis://redis:6379/2
NOTIFICATION_STREAM_ENABLED=True

# CORS 跨域
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost

# 字段加密密钥（生产环境必须配置固定密钥，否则重启后无法解密历史数据）
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=GENERATE-A-FERNET-KEY

# 受保护媒体：签名 URL 有效期（秒），生产环境由 Nginx internal 转发
PROTECTED_MEDIA_URL_TTL=7200
PROTECTED_MEDIA_USE_X_ACCEL_REDIRECT=True

# HTTPS 重定向（部署 SSL 前设为 False 以通过 HTTP 访问；启用 SSL 后设为 True）
SECURE_SSL_REDIRECT=False

# 邮件配置
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
