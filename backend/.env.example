# ============ Django 配置 ============
# 密钥（生产环境必须修改）
DJANGO_SECRET_KEY=your-secret-key-here

# ============ 数据库配置 (PostgreSQL) ============
DB_NAME=team_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ============ 允许的主机（生产环境）============
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ============ CORS 配置（生产环境）============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============ Celery 配置（架构预留）============
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ============ 字段加密密钥（第三期敏感资料模块使用）============
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# ============ 受保护媒体 ============
# 开发环境保持 False，由 Django 发送；生产环境应设为 True 并使用 Nginx internal location。
PROTECTED_MEDIA_URL_TTL=7200
PROTECTED_MEDIA_USE_X_ACCEL_REDIRECT=False

# ============ 票据 OCR ============
# Windows 本地开发可填写 tesseract.exe 的绝对路径；容器内通常无需设置。
TESSERACT_CMD=
# 自定义语言包目录（目录内应包含 chi_sim.traineddata 与 eng.traineddata）。
TESSDATA_PREFIX=
OCR_TESSERACT_LANG=chi_sim+eng

# ============ 演示备份 ============
# 留空时默认保存在 backend/demo_backups。
DEMO_BACKUP_ROOT=
