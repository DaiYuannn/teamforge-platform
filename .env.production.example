# ============================================================
# 生产环境变量模板
#
# 使用方法:
#   1. 复制本文件为 .env.production
#   2. 将所有 <CHANGE_ME> 替换为真实值
#   3. 绝不要将 .env.production 提交到 Git
#
# 生成密钥的命令:
#   DJANGO_SECRET_KEY:
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   FIELD_ENCRYPTION_KEY:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

# ============ Django 配置 ============
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=<CHANGE_ME_TO_RANDOM_SECRET_KEY>
DEBUG=False
ALLOWED_HOSTS=your-domain.com,127.0.0.1

# ============ 数据库配置 (PostgreSQL) ============
DB_NAME=team_management
DB_USER=postgres
DB_PASSWORD=<CHANGE_ME_TO_STRONG_PASSWORD>
DB_HOST=postgres
DB_PORT=5432

# ============ Redis / Celery ============
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============ CORS 跨域 ============
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============ HTTPS ============
# 部署 SSL 前设为 False，启用 SSL 后设为 True
SECURE_SSL_REDIRECT=False

# ============ 字段加密密钥（敏感资料加密/解密）============
# 警告: 此密钥一旦丢失，所有已加密的敏感资料将无法解密
# 警告: 此密钥一旦泄露，所有敏感资料将被破解
# 请妥善备份此密钥到安全位置
FIELD_ENCRYPTION_KEY=<CHANGE_ME_TO_FERNET_KEY>

# ============ 邮件配置 (SMTP) ============
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=<CHANGE_ME_TO_EMAIL_ADDRESS>
EMAIL_HOST_PASSWORD=<CHANGE_ME_TO_EMAIL_AUTH_CODE>
