# ============================================================
# 根目录 Docker Compose 环境变量模板
#
# 使用方法:
#   1. 复制本文件为 .env.docker
#   2. 将所有 <CHANGE_ME> 替换为真实值
#   3. 绝不要将 .env.docker 提交到 Git
# ============================================================

# ============ Django 配置 ============
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=<CHANGE_ME_TO_RANDOM_SECRET_KEY>
DEBUG=False
ALLOWED_HOSTS=your-domain.com,127.0.0.1
FRONTEND_URL=https://your-domain.com

# ============ 数据库配置 (PostgreSQL) ============
# 根 docker-compose.yml 的数据库服务名是 db。
DB_NAME=team_management
DB_USER=postgres
DB_PASSWORD=<CHANGE_ME_TO_STRONG_PASSWORD>
DB_HOST=db
DB_PORT=5432

# ============ Redis / Celery ============
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============ CORS 跨域 ============
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============ HTTPS ============
# 部署 SSL 前设为 False，启用 SSL 后设为 True
SECURE_SSL_REDIRECT=False

# ============ 字段加密密钥（敏感资料加密/解密）============
# 此密钥丢失后，已加密的敏感资料将无法解密；请备份到安全位置。
FIELD_ENCRYPTION_KEY=<CHANGE_ME_TO_FERNET_KEY>

# ============ 受保护媒体 ============
PROTECTED_MEDIA_URL_TTL=7200
PROTECTED_MEDIA_USE_X_ACCEL_REDIRECT=True

# ============ 邮件配置 (SMTP) ============
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=<CHANGE_ME_TO_EMAIL_ADDRESS>
EMAIL_HOST_PASSWORD=<CHANGE_ME_TO_EMAIL_AUTH_CODE>
